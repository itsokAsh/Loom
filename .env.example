# =============================================================================
# Loom — environment configuration
# Copy to .env and edit before deploy:  cp .env.example .env
# =============================================================================

# --- Required for production (docker-compose.prod.yml) ---
# Generate secrets (PowerShell):
#   -join ((48..57 + 65..90 + 97..122 | Get-Random -Count 32 | ForEach-Object {[char]$_})
# Linux/macOS: openssl rand -hex 32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-postgres-password

ADMIN_API_KEY=change-me-strong-admin-key
SERVICE_TOKEN=change-me-strong-service-token
CREDENTIALS_ENCRYPTION_KEY=change-me-32-char-min-encryption-key

# Public URL of the API *with* /v1 (used for gallery webhook links in API responses)
# Examples:
#   http://localhost:3000/v1          (local Docker, UI on :3000)
#   https://loom.yourdomain.com/v1    (production with Caddy)
TRIGGER_PUBLIC_URL=http://localhost:3000/v1

# --- Optional ---
# UI host port when not using TLS profile (default 3000)
UI_PORT=3000

# Domain for Caddy automatic HTTPS (required with --profile tls)
# DEPLOY_DOMAIN=loom.yourdomain.com

# SendGrid — required only if you use the Email node
SENDGRID_API_KEY=

# UI build-time (usually leave as-is; API is proxied at /v1 by nginx)
VITE_API_URL=/v1
VITE_WEBHOOK_BASE=/v1/webhooks

# --- Local dev only (defaults in docker-compose.yml) ---
# ADMIN_API_KEY=dev-admin-key
# SERVICE_TOKEN=loom-dev-service-token
# CREDENTIALS_ENCRYPTION_KEY=loom-dev-credentials-key-change-me
