**2. `GET /v1/workflows/{id}` — Get a workflow by ID**

What it does: Returns the workflow metadata.

```go
// Response (200 OK):
// {
//   "id": "a1b2c3d4-...",
//   "name": "Welcome Email Flow",
//   "createdAt": "2026-07-16T10:00:00Z"
// }

func (h *Handler) GetWorkflow(w http.ResponseWriter, r *http.Request) {
    id := chi.URLParam(r, "id")

    // Parse the string ID into pgtype.UUID
    var pgID pgtype.UUID
    if err := pgID.Scan(id); err != nil {
        http.Error(w, "Invalid workflow ID format", http.StatusBadRequest)
        return
    }

    wf, err := h.service.GetWorkflow(r.Context(), pgID)
    if err != nil {
        http.Error(w, "Workflow not found", http.StatusNotFound)
        return
    }

    w.Header().Set("Content-Type", "application/json")
    json.NewEncoder(w).Encode(wf)
}
```

